APP_ENV=development
DATABASE_URL=sqlite:///./data/clash_detection.db
STORAGE_ROOT=./data/storage
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=52428800

# Local development is deterministic and requires no model server.
INFERENCE_PROVIDER=mock
INFERENCE_BASE_URL=http://model:8000/v1
INFERENCE_API_KEY=local
INFERENCE_TIMEOUT_SECONDS=180
MAX_CONCURRENT_INFERENCE=1

# This pair comes from the adapter's own adapter_config.json.
MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
SERVED_MODEL_NAME=clash-detection-qwen2.5-vl-7b
ADAPTER_NAME=train_2026-07-29-14-13-40
PROMPT_VERSION=clash-analysis-v1
PARSER_VERSION=navisworks-v1
SEVERITY_RULE_VERSION=severity-v1
